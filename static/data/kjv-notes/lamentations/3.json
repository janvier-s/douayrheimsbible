[{"verse":13,"text":"arrows: Heb. sons"},{"verse":15,"text":"bitterness: Heb. bitternesses"},{"verse":16,"text":"covered me with ashes: Or, rolled me in the ashes"},{"verse":17,"text":"prosperity: Heb. good"},{"verse":19,"text":"Remembering: Or, remember"},{"verse":20,"text":"humbled: Heb. bowed"},{"verse":21,"text":"recall to my mind: Heb. make to return to my heart"},{"verse":33,"text":"willingly: Heb. from his heart"},{"verse":35,"text":"most high: Or, a superior"},{"verse":36,"text":"approveth not: Or, seeth not"},{"verse":39,"text":"complain: Or, murmur"},{"verse":51,"text":"mine heart: Heb. my soul | because of all: Or, more then all"},{"verse":65,"text":"sorrow of the heart: Or, obstinacy of heart"}]