[{"verse":3,"text":"from the South: Heb. from the sea"},{"verse":22,"text":"rejoicing: Heb. singing"},{"verse":25,"text":"raiseth: Heb. maketh to stand"},{"verse":27,"text":"are at their wits end: Heb. all their wisdom is swallowed up"},{"verse":34,"text":"barrenness: Heb. saltiness"},{"verse":40,"text":"wilderness: Or, void place"},{"verse":41,"text":"from: Or, after"}]