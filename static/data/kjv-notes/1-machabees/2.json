[{"verse":1,"text":"Or Mattathias the son of John, [illeg.] arose from Jerusalem, or out of Jerusalem"},{"verse":2,"text":"Or, who was called: and so afterward in the rest. , Gaddis."},{"verse":5,"text":"Or, Auaron, or Abaron."},{"verse":12,"text":"Or, holy thing."},{"verse":26,"text":"Num.25. 9."},{"verse":29,"text":"Gr. sit, abide."},{"verse":30,"text":"Gr. evils were multiplied upon them."},{"verse":35,"text":"Gr. the Jews."},{"verse":37,"text":"Gr. simplicity."},{"verse":38,"text":"Gr. souls of men."},{"verse":46,"text":"Or, by force"},{"verse":48,"text":"Gr. gave they the horse to the sinner."},{"verse":51,"text":"Gr. generations."},{"verse":52,"text":"Gene.22 9, 10. rom. 43."},{"verse":53,"text":"Gene.41. 40."},{"verse":54,"text":"Num.25.18. ecclus. 45.23.24."},{"verse":55,"text":"Josh.1.2"},{"verse":56,"text":"Num.14. 6.7. Josh. 14.13."},{"verse":57,"text":"2.Sam. 2. 4."},{"verse":58,"text":"2 Kin. 2. 11."},{"verse":59,"text":"Dan 3.16. 17. 18, and 16."},{"verse":60,"text":"Dan.6.22."},{"verse":63,"text":"Psal.146. 4."},{"verse":66,"text":"To fight ye the battle of the people."}]