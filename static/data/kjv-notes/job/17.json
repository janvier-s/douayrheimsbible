[{"verse":1,"text":"My breath is corrupt: Or, my spirit is spent"},{"verse":2,"text":"continue: Heb. lodge"},{"verse":6,"text":"aforetime: Or, before them"},{"verse":7,"text":"my members: Or, my thoughts"},{"verse":9,"text":"shall be stronger: Heb. shall add strength"},{"verse":11,"text":"the thoughts: Heb. the possessions"},{"verse":12,"text":"short: Heb. near"},{"verse":14,"text":"said: Heb. cried, or called"}]