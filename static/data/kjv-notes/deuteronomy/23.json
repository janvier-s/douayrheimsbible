[{"verse":6,"text":"prosperity: Heb. good"},{"verse":11,"text":"cometh: Heb. turneth toward"},{"verse":13,"text":"wilt ease: Heb. sitteth down"},{"verse":14,"text":"unclean thing: Heb. nakedness of any thing"},{"verse":16,"text":"liketh him best: Heb. is good for him"},{"verse":17,"text":"whore: Or, sodomitess"}]