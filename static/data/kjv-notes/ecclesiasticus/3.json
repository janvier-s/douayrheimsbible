[{"verse":2,"text":"Exo.20.6. deut. 5. 10. , Or, judgement."},{"verse":8,"text":"Exod.20. 12. deut. 5. 10."},{"verse":9,"text":"Gene.27. 27. deu.33. 1."},{"verse":13,"text":"Or, in all thine ability."},{"verse":18,"text":"Phil.2.3."},{"verse":19,"text":"Psal.25. 9,14."},{"verse":21,"text":"Prov.25. 27. rom.12. 3."},{"verse":28,"text":"Or, the proud man is not healed by his punishment."},{"verse":30,"text":"Psal.40.2. dan.4.24. matth.5. 7."}]