[{"verse":1,"text":"Or, seasonable."},{"verse":4,"text":"Chap. 30. 20."},{"verse":6,"text":"Eccle.3.7."},{"verse":7,"text":"Cha.32.4."},{"verse":13,"text":"Chap.6.5. , Or, pleasant conceits. , Lost, or spilt."},{"verse":14,"text":"Gr. for, his eyes are many for one to receive."},{"verse":19,"text":"Or, an unpleasant fellow."},{"verse":21,"text":"Gr. shall not be pricked."},{"verse":24,"text":"Cha.25.2."},{"verse":26,"text":"Or, ignominy."},{"verse":28,"text":"Prov.12. 11. and 28. 19."},{"verse":29,"text":"Exo.23.8. deu. 16.19. , Or, as a muzzle in the mouth."}]