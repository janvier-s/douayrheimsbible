[{"verse":3,"text":"Or, as the asking of Urim."},{"verse":5,"text":"Greeke, bowels. , Chap. 21. 16."},{"verse":9,"text":"Or, ordained for the number of days."},{"verse":10,"text":"Gen. 1. 27. and 2.7."},{"verse":12,"text":"Or, standings."},{"verse":13,"text":"Esay 45.9. rom.9.20, 21."},{"verse":16,"text":"Or, gleaneth."},{"verse":17,"text":"Chap. 24. 39."},{"verse":20,"text":"Or, sell not."},{"verse":21,"text":"Or, look to their hands."},{"verse":24,"text":"Of servants."},{"verse":30,"text":"Chap.7. 20. , Greeke, in blood."}]