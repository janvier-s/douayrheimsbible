[{"verse":2,"text":"Or, a gift"},{"verse":5,"text":"Exod. 15. 25."},{"verse":9,"text":"Esay.38.2."},{"verse":11,"text":"Or, as a dead man."},{"verse":14,"text":"Or, curing."},{"verse":18,"text":"Prov.15. 13. and 17. 22."},{"verse":22,"text":"Or, the sentence upon him."},{"verse":23,"text":"2.Sam.12. 20."},{"verse":25,"text":"Greeke, of the breed of bullocks."},{"verse":30,"text":"Or, tempereth it with his feet."}]