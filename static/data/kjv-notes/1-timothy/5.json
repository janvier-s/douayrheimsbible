[{"verse":4,"text":"piety: Or, kindness"},{"verse":6,"text":"in pleasure: Or, delicately"},{"verse":8,"text":"house: Or, kindred"},{"verse":9,"text":"taken: Or, chosen"},{"verse":14,"text":"to speak reproachfully: Gr. for their railing"},{"verse":19,"text":"before: Or, under"},{"verse":21,"text":"without preferring: Or, without prejudice"}]