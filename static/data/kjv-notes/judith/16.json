[{"verse":1,"text":"Or, this praising."},{"verse":2,"text":"Or, Psalm and praise."},{"verse":4,"text":"Chap.2. 11,15."},{"verse":8,"text":"Gr. or miter."},{"verse":10,"text":"Or, confounded."},{"verse":11,"text":"The Assyrians."},{"verse":13,"text":"Or, a song of praise."},{"verse":23,"text":"Or, sepulchre."},{"verse":24,"text":"Gen.50. 10."}]