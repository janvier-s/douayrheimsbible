[{"verse":1,"text":"2.King.23. 22. 2.chro. 35.1."},{"verse":8,"text":"Or, Iehiel."},{"verse":9,"text":"Five hundred calves, 2.chro.35.9."},{"verse":11,"text":"2. Chron. 35.12. And so of the bullocks."},{"verse":12,"text":"With good speed, or willingly, 2. chron.35. 13."},{"verse":15,"text":"2.Chron. 35.15. of David and Asaph. , 2. Chro. 35.15. the kings seer."},{"verse":24,"text":"Or, were ungodly. , Or, sensibly."},{"verse":25,"text":"2.Chron. 35.20."},{"verse":34,"text":"2.King. 23.30. 2. chron. 36.1"},{"verse":39,"text":"2. Chro. 36.45. Iehoiakim, or Eliakim."},{"verse":57,"text":"Jer.25.11 and 29.10."},{"verse":58,"text":"Or, Keep Sabbath."}]