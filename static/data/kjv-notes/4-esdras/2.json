[{"verse":7,"text":"Sacrament or oath."},{"verse":8,"text":"Gene. 19. 24."},{"verse":15,"text":"Or, bring them up with gladness as a done: make their feet fast. For, &c."},{"verse":16,"text":"Or, thy name, O Israel."},{"verse":23,"text":"Tob.17. 18. , Signing bury them."},{"verse":32,"text":"Or, preach."},{"verse":38,"text":"Or, for."},{"verse":40,"text":"Lat. conclude."},{"verse":42,"text":"Reu.7.9."},{"verse":44,"text":"Or, Lord."}]