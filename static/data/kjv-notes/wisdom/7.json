[{"verse":2,"text":"Job.10. 12."},{"verse":6,"text":"Job.1.21. 1.Timo.6.7"},{"verse":9,"text":"Gre. stone of inestimable price."},{"verse":11,"text":"1.King.3. 13. matt.6. 33."},{"verse":13,"text":"Greeke, without guile. , Gr. without envy."},{"verse":14,"text":"Or, enter friendship with God."},{"verse":15,"text":"Or, God grant. , Or, are to be spoken of."},{"verse":22,"text":"Greeke, only begotten."},{"verse":25,"text":"Or, vapour. , Or, stream."},{"verse":26,"text":"Hebr.1.3."},{"verse":27,"text":"Or, createth."}]