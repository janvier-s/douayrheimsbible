[{"verse":4,"text":"Esai.44.8, 9,10. and 46. 5,7. psal.115.4. wis.13.10."},{"verse":11,"text":"Or, which prostitute themselves openly."},{"verse":18,"text":"Or, courts."},{"verse":20,"text":"Gr. licked."},{"verse":25,"text":"Or, any price."},{"verse":26,"text":"Esa.46.7."},{"verse":27,"text":"Or, offerings"},{"verse":28,"text":"Or, spend."},{"verse":29,"text":"Lev.12.4."},{"verse":41,"text":"Or, bid him call upon Bel."},{"verse":42,"text":"Or, sence."},{"verse":50,"text":"Psal 115. 4. wisdom. 13.10."},{"verse":61,"text":"Or, the same wind."},{"verse":72,"text":"Or purple and brightness."}]