[{"verse":4,"text":"Or, kindenesse."},{"verse":6,"text":"Or, delicately."},{"verse":8,"text":"Or, kindred."},{"verse":9,"text":"Or, chosen."},{"verse":14,"text":"Gr. for their railing."},{"verse":18,"text":"Deut. 25. 4. , Matth. 10. 10."},{"verse":19,"text":"Or, vnder."},{"verse":21,"text":"Or, without preiudice."}]