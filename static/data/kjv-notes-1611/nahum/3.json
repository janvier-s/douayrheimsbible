[{"verse":1,"text":"Heb. Citie of bloods. , Eze.24.9. hab.2.10."},{"verse":3,"text":"Heb. the flame of the sword and the lightning of the speare."},{"verse":5,"text":"Esa.47.3. ezek.16. 37."},{"verse":8,"text":"Or, nourishing. Hebr. No Amon."},{"verse":9,"text":"Heb. in thy helpe."},{"verse":11,"text":"Iere.25. 17."},{"verse":16,"text":"Or, spreadeth himselfe."},{"verse":18,"text":"Or, valiant ones."},{"verse":19,"text":"Heb. wrinkling."}]