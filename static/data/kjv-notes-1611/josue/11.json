[{"verse":5,"text":"Hebr. assembled by appointment."},{"verse":8,"text":"Or, Zidon-Rabbah. , Or, salt pits: Hebr. burning of waters."},{"verse":11,"text":"Hebr. any breath."},{"verse":12,"text":"Num.33. 52. deut. 7. 2. and 20, 16,17."},{"verse":13,"text":"Hebr. on their heape."},{"verse":15,"text":"Exod.34. 11. , Deut. 7.2 , Heb. he remoued nothing."},{"verse":17,"text":"Or, the smoothe mountaine."},{"verse":19,"text":"Chap.9.3"},{"verse":23,"text":"Numb.26 53."}]