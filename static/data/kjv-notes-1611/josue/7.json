[{"verse":1,"text":"Chap.22. 20. 1.chron. 2.7."},{"verse":3,"text":"Heb. about 2000.men: or, about 3000.men."},{"verse":5,"text":"Or, in Morad."},{"verse":8,"text":"Hebr. neckes."},{"verse":10,"text":"Heb. fallest."},{"verse":15,"text":"Or, wickednesse."},{"verse":21,"text":"Heb. tongue"},{"verse":23,"text":"Heb. powred."},{"verse":26,"text":"That is, trouble."}]