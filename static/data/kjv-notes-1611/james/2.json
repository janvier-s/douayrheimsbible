[{"verse":2,"text":"Gr. Synagogue."},{"verse":3,"text":"Or, well, or seemely."},{"verse":5,"text":"Or, that."},{"verse":11,"text":"Or, that Law which said."},{"verse":13,"text":"Or, glorieth"},{"verse":17,"text":"Gr. by it selfe."},{"verse":18,"text":"Some copies reade, by thy workes."},{"verse":22,"text":"Or, thou seest."},{"verse":23,"text":"Gen.15.6 rom.4.3. gal.3.6."},{"verse":26,"text":"Or, breath."}]