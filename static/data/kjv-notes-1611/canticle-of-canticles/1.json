[{"verse":2,"text":"Chap.4. 10. , Hebr. thy loues."},{"verse":4,"text":"Ioh. 6.44. , Or, they loue thee vprightly."},{"verse":7,"text":"Or, as one that is vailed."},{"verse":14,"text":"Or, Cypres."},{"verse":15,"text":"Or, my companion."},{"verse":16,"text":"Chap.4.1 and 5.12."},{"verse":17,"text":"Or, galleries."}]