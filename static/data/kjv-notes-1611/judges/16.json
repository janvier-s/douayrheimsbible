[{"verse":1,"text":"Heb. a woman an harlot."},{"verse":2,"text":"Heb. silent."},{"verse":3,"text":"Heb. with the barre."},{"verse":4,"text":"Or, by the brooke."},{"verse":5,"text":"Or, humble."},{"verse":7,"text":"Or, newe coards. Heb. moist. , Heb. one."},{"verse":9,"text":"Heb. smeleth."},{"verse":11,"text":"Heb. wherwith worke hath not ben done."},{"verse":16,"text":"Heb. shortned."},{"verse":21,"text":"Hebr. boared out."},{"verse":22,"text":"Or, as when he was shauen."},{"verse":24,"text":"Hebr. and who multiplied our slaine."},{"verse":25,"text":"Hebr. before them."},{"verse":29,"text":"Or, he leaned on them."},{"verse":30,"text":"Hebr. my soule."}]