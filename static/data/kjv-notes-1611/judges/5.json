[{"verse":4,"text":"Deut.4. 11."},{"verse":5,"text":"Psal.97.5. , Hebr. flowed. , Exod.19. 18."},{"verse":6,"text":"Chap.3. 31. , Chap.4. 18. , Hebr. walkers of paths. , Hebr. crooked wayes."},{"verse":10,"text":"Or, meditate."},{"verse":11,"text":"Hebr. righteousnesses of the Lord."},{"verse":14,"text":"Heb. drawe with the pen, &c."},{"verse":15,"text":"Hebr. his feete. , Or, in the diuisions, &c. , Hebr. impressions."},{"verse":16,"text":"Or, in."},{"verse":17,"text":"Or, port. , Or, creeks."},{"verse":18,"text":"Heb. exposed to reproch."},{"verse":20,"text":"Heb. paths."},{"verse":22,"text":"Or, tramplings, or plungings."},{"verse":26,"text":"Heb. hammered."},{"verse":27,"text":"Hebr. betweene. , Heb. destroyed."},{"verse":29,"text":"Heb. words"},{"verse":30,"text":"Heb. to the head of a man. , Hebr. for the neckes of the spoils."}]