[{"verse":1,"text":"Hebr. what thing is this, thou hast done vnto vs? , Hebr. strongly."},{"verse":3,"text":"Heb. spirit."},{"verse":7,"text":"Heb. thresh"},{"verse":10,"text":"Or, an hundreth and twenty thousand, euery one drawing a sword."},{"verse":12,"text":"Heb. terrified."},{"verse":14,"text":"Heb. writ."},{"verse":16,"text":"Heb. made to know."},{"verse":17,"text":"1.King.12 25."},{"verse":18,"text":"Heb. according to the forme, &c."},{"verse":21,"text":"Or, ornaments like the moone."},{"verse":26,"text":"Or, sweete iewels."},{"verse":30,"text":"Heb. going out of his thigh."},{"verse":31,"text":"Heb. set."}]