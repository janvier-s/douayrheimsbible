[{"verse":8,"text":"Hebr. Aram-naharaim."},{"verse":9,"text":"Hebr. sauiour."},{"verse":10,"text":"Hebr. was. , Hebr. Aram."},{"verse":15,"text":"Or, the sonne of Iemini. , Hebr. shut of his right hand."},{"verse":19,"text":"Or, grauen images."},{"verse":20,"text":"Heb. a parlour of cooling."},{"verse":22,"text":"Or, it came out at the fundament."},{"verse":24,"text":"Or, doth his easement."},{"verse":29,"text":"Heb. fat."}]