[{"verse":2,"text":"Hebr. a fire of law."},{"verse":8,"text":"Exod. 28. 30."},{"verse":10,"text":"Or, let them teach, &c. , Or, let them put incense. , Heb. at thy nose."},{"verse":13,"text":"Gen.49. 25."},{"verse":14,"text":"Heb. thrust forth. , Hebr. Moones."},{"verse":16,"text":"Gen.49. 26."},{"verse":21,"text":"Heb. sieled."},{"verse":25,"text":"Or, vnder thy shooes shalbe yron."},{"verse":28,"text":"Ier.23.6"},{"verse":29,"text":"Or, shal be subdued."}]