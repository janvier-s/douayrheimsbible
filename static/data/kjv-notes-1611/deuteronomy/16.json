[{"verse":1,"text":"Exod. 12. 2. &c. , Exod. 13. 4."},{"verse":2,"text":"Chap.12. 5."},{"verse":3,"text":"Exod. 12. 15."},{"verse":4,"text":"Exod. 34. 25."},{"verse":5,"text":"Or, kill."},{"verse":8,"text":"Hebr. restraint."},{"verse":9,"text":"Leuit. 23. 15."},{"verse":10,"text":"Or, sufficiencie."},{"verse":13,"text":"Heb. floore and thy wine presse."},{"verse":16,"text":"Exod. 23. 14. and 34. 23. , Ecclus. 35.4."},{"verse":17,"text":"Heb. according to the gift of his hand."},{"verse":19,"text":"Exod. 23. 8. , Or, matters"},{"verse":20,"text":"Heb. iustice, iustice."},{"verse":22,"text":"Leuit. 26. 1. , Or, statue, or pillar."}]