[{"verse":1,"text":"Or, saue."},{"verse":2,"text":"Hebr. an heart, and an heart."},{"verse":3,"text":"Hebr. great things."},{"verse":4,"text":"Hebr. are with vs."},{"verse":5,"text":"Or, would ensnare him."},{"verse":6,"text":"2. Sam. 23. 31. psal.18. 29. & 119. ver.140. prou.30.5."},{"verse":7,"text":"Heb. him.i.euery one of them."},{"verse":8,"text":"Hebr. the vilest of the sonnes of men are exalted."}]