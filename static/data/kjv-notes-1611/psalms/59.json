[{"verse":1,"text":"Heb. set me on high."},{"verse":4,"text":"Hebr. to meete me."},{"verse":7,"text":"Psal. 10. 11. and 73. 11. and 94. 7."},{"verse":9,"text":"Hebr. my high place."},{"verse":10,"text":"Hebr. mine obseruers."},{"verse":15,"text":"Hebr. to eate. , Or, if they be not satisfied, then they will stay all night."}]