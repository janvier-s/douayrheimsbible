[{"verse":1,"text":"Prou.23. 17. & 24.1."},{"verse":3,"text":"Hebr. in trueth and stablenesse."},{"verse":5,"text":"Heb. rolle thy way vpon the Lord. , Prou.16.3 mat.6.25. 1.Pet.5.7."},{"verse":7,"text":"Hebr. be silent to the LORD."},{"verse":11,"text":"Matt.5.5."},{"verse":12,"text":"Or, practiseth."},{"verse":13,"text":"Psal.2.4."},{"verse":14,"text":"Heb. the vpright of way."},{"verse":20,"text":"Hebr. the preciousnes of Lambes."},{"verse":23,"text":"Or, established."},{"verse":26,"text":"Hebr. all the day."},{"verse":31,"text":"Or, going."},{"verse":35,"text":"Or, a greeve tree, that groweth him owne soyle."}]