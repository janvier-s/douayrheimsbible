[{"verse":3,"text":"Heb. peace, or health."},{"verse":6,"text":"Hebr. wryed."},{"verse":10,"text":"Heb. is not with me."},{"verse":11,"text":"Heb. stroke , Or, my neighbours."},{"verse":15,"text":"Or, thee do I wast for. , Or, answere."},{"verse":17,"text":"Heb. for haulting."},{"verse":19,"text":"Heb. being liuing, are strong."},{"verse":22,"text":"Heb. for my helpe."}]