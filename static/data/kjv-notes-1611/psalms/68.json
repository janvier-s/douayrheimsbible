[{"verse":1,"text":"Num.10. 36. , Hebr. from his face."},{"verse":3,"text":"Hebr. reioyce with gladnesse."},{"verse":6,"text":"Hebr. in a house."},{"verse":9,"text":"Hebr. shake out. , Hebr. confirme it."},{"verse":11,"text":"Hebr. armie."},{"verse":12,"text":"Hebr. did flee, did flee."},{"verse":14,"text":"Or, for her, she was."},{"verse":17,"text":"Or, euen many thousands."},{"verse":18,"text":"Eph.4.8. , Heb. in the man."},{"verse":23,"text":"Or, red."},{"verse":26,"text":"Or, ye that are of the fountaine of Israel."},{"verse":27,"text":"Or, with their company."},{"verse":30,"text":"Or, the beast of the reeds. , Or, be scattereth."},{"verse":33,"text":"Heb. giue."},{"verse":34,"text":"Or, heauens."}]