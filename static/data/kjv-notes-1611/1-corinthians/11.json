[{"verse":2,"text":"Or, traditions."},{"verse":10,"text":"That is, a couering, in signe that she is vnder the power of her husband"},{"verse":15,"text":"Or, vaile."},{"verse":18,"text":"Or, schismes."},{"verse":19,"text":"Or, sects."},{"verse":20,"text":"Or, ye cannot eate."},{"verse":22,"text":"Or, them that are poore."},{"verse":24,"text":"Mat.26.16 mar.14.22. luk. 22.19. , Or, for a rembrance."},{"verse":26,"text":"Or, shew yee."},{"verse":29,"text":"Or, iudgement."},{"verse":34,"text":"Or iudgement."}]