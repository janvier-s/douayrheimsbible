[{"verse":1,"text":"Ezra 3.1. and 7.6."},{"verse":2,"text":"Heb. that vnderstood in hearing."},{"verse":3,"text":"Heb. from the light."},{"verse":4,"text":"Heb. towre of wood."},{"verse":5,"text":"Hebr. eyes."},{"verse":9,"text":"Or, the gouernour."},{"verse":13,"text":"Or, that they might instruct in the words of the Law."},{"verse":14,"text":"Heb. by the hand of. , Leuit. 23. 34. deut. 16.13."},{"verse":18,"text":"Heb. are straint."}]