[{"verse":1,"text":"Heb. sought the face &c."},{"verse":2,"text":"Iosh. 9.3. 16,17."},{"verse":4,"text":"Or, It is not siluer or gold that we haue to doe with Saul or his house, neither pertaines it to vs to kil &c."},{"verse":5,"text":"Or, cut vs off."},{"verse":6,"text":"Or, chosen of the Lord."},{"verse":7,"text":"1.Sam.18 3. and 20.8, 42."},{"verse":8,"text":"Or, Michals sister. , Heb. bare to Adriel."},{"verse":10,"text":"Chap. 3.7."},{"verse":12,"text":"1. Sam. 31.10."},{"verse":16,"text":"Or, Rapha. , Heb. the staffe, or the head."},{"verse":17,"text":"Heb. candle, or lampe"},{"verse":18,"text":"1.Chron. 20.4. , Or, Rapha."},{"verse":19,"text":"See 1. Chro.20.5."},{"verse":20,"text":"Or, Rapha."},{"verse":21,"text":"Or, reproched. , 1. Sam. 16.9."}]