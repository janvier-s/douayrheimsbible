[{"verse":4,"text":"Hebr. I doe obeysance."},{"verse":5,"text":"Or, he still came foorth and cursed."},{"verse":7,"text":"Hebr. man of blood."},{"verse":8,"text":"Hebr. behold thee in thy euill."},{"verse":9,"text":"1.Sam.24. 15. chap.3. 8."},{"verse":12,"text":"Or, teares, Hebr. eye."},{"verse":13,"text":"Hebr. dusted him with dust."},{"verse":16,"text":"Heb. let the king liue."},{"verse":23,"text":"Heb. word."}]