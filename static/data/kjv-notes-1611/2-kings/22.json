[{"verse":2,"text":"Psal. 18.2. &c."},{"verse":5,"text":"Or, pangs. , Heb. Belial."},{"verse":6,"text":"Or, coards."},{"verse":9,"text":"Heb. by."},{"verse":12,"text":"Hebr. binding of waters."},{"verse":17,"text":"Or, great."},{"verse":24,"text":"Hebr. to him."},{"verse":25,"text":"Hebr. before his eyes."},{"verse":27,"text":"Or, wrestle. ps. 18.27."},{"verse":29,"text":"Or, candle."},{"verse":30,"text":"Or, broken a troupe."},{"verse":31,"text":"Or, refined."},{"verse":33,"text":"Hebr. riddeth, or, looseth."},{"verse":34,"text":"Heb. equalleth."},{"verse":35,"text":"Hebr. for the warre."},{"verse":36,"text":"Hebr. multiplied me."},{"verse":37,"text":"Hebr. ancles."},{"verse":40,"text":"Hebr. caused to bow."},{"verse":45,"text":"Heb. sonnes of the stranger. , Or, yeeld fained obedience. Heb. lye."},{"verse":48,"text":"Hebr. giueth auengement for me."},{"verse":50,"text":"Rom. 15.9"},{"verse":51,"text":"Cha. 7.13"}]