[{"verse":1,"text":"Or, looke."},{"verse":2,"text":"Or, indignation."},{"verse":6,"text":"Or, iniquity."},{"verse":7,"text":"Or, labour. , Heb. the sonnes of the burning coale, lift vp to flie."},{"verse":9,"text":"Cha.9.10. psal.72.18. rom.11.33. , Heb. and there is no search. , Heb. till there be no number."},{"verse":10,"text":"Heb. outplaces."},{"verse":11,"text":"Psa.113.6. 1.sam.2.7."},{"verse":12,"text":"Neh.4.15. psal. 33.10. isa.8.10. , Or, cannot performe anything."},{"verse":13,"text":"1.Cor.3. 19."},{"verse":14,"text":"Deut.28. 29. , Or, runne into."},{"verse":16,"text":"Psal. 107. 42."},{"verse":17,"text":"Pro.3.12. iames 1.12. heb.12.5. apoc.3. 9."},{"verse":18,"text":"Deut.32. 39. 1.sam. 2.6. isa.30. 26. hos.6.1."},{"verse":19,"text":"Psal.91.3."},{"verse":20,"text":"Heb. from the hands."},{"verse":21,"text":"Or, when the tongue scourgeth."},{"verse":23,"text":"Hos.2.18."},{"verse":24,"text":"Or, that peace is thy tabernacle. , Or, erre."},{"verse":25,"text":"Or, much."},{"verse":26,"text":"Heb. ascendeth."},{"verse":27,"text":"Heb. for thyselfe."}]