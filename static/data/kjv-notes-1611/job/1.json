[{"verse":1,"text":"Chap.2.3."},{"verse":3,"text":"Or, cattell. , Or, husbandrie. , Heb. sonnes of the East."},{"verse":5,"text":"1.King. 21.10, 13. , Heb. all the dayes."},{"verse":6,"text":"Heb. the aduersarie. , Heb. in the midst of them."},{"verse":7,"text":"1.Pet.5.8."},{"verse":8,"text":"Heb. hast thou set thy heart on?"},{"verse":10,"text":"Or, cattell."},{"verse":11,"text":"Hebr. if he curse thee not to thy face."},{"verse":12,"text":"Heb. hand."},{"verse":16,"text":"Or, a great fire."},{"verse":17,"text":"Hebr. rushed."},{"verse":19,"text":"Heb from a side, &c."},{"verse":20,"text":"Or, robe."},{"verse":21,"text":"Eccles.5. 14. 1.tim. 6.7."},{"verse":22,"text":"Or, attributed folly to God."}]