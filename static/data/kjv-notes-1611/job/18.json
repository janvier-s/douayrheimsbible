[{"verse":4,"text":"Hebr. his soule."},{"verse":6,"text":"Or, lampe."},{"verse":10,"text":"Heb. hidden."},{"verse":11,"text":"Heb. scatter him."},{"verse":13,"text":"Heb. barres"},{"verse":14,"text":"Cha.8.14. and 11. 20. psa. 112. 10. pro. 10.28."},{"verse":17,"text":"Pro.2.22."},{"verse":18,"text":"Heb. they shall driue him."},{"verse":20,"text":"Or, liued with him. , Heb. layd holde on horror."}]