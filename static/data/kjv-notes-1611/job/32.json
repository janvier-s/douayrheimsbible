[{"verse":1,"text":"Heb. from answering."},{"verse":2,"text":"Heb. his soule."},{"verse":4,"text":"Heb. expected Iob in words. , Heb. elder for dayes."},{"verse":6,"text":"Heb. few of dayes. , Heb. I feared."},{"verse":8,"text":"Iob.38.36 prou. 2.6. eccl. 2.26. dan. 1.17. & 2.21."},{"verse":11,"text":"Heb. vnderstandings , Heb. words"},{"verse":14,"text":"Or, ordered his words."},{"verse":15,"text":"Heb. they remoued speeches from themselues."},{"verse":18,"text":"Heb. words , Heb. the spirit of my belly."},{"verse":19,"text":"Heb. is not opened."},{"verse":20,"text":"Heb. that I may breath."}]