[{"verse":1,"text":"Heb. added to take vp."},{"verse":3,"text":"Or.lampe"},{"verse":6,"text":"Heb. with me."},{"verse":10,"text":"Heb. the voice of the nobles was hid."},{"verse":17,"text":"Heb. the iaw teeth or the grinders , Heb. I cast"},{"verse":19,"text":"Heb. opened."},{"verse":20,"text":"Heb. new. , Heb. changed."}]