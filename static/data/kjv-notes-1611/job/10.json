[{"verse":1,"text":"Or, eue of while I liue."},{"verse":3,"text":"Heb. the labour of thine hands."},{"verse":7,"text":"Heb. It is vpon thy knowledge."},{"verse":8,"text":"Heb. tooke praises about me."},{"verse":10,"text":"Psal.139. 4 and 14, 15."},{"verse":11,"text":"Heb. hedged."},{"verse":17,"text":"That is, thy plagues."},{"verse":18,"text":"Chap.3. 11."},{"verse":20,"text":"See Chap. 8.9. and 7. 6."}]