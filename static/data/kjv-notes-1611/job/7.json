[{"verse":1,"text":"Or, warfare."},{"verse":2,"text":"Hebr. gapeth after."},{"verse":4,"text":"Hebr. the euening be measured."},{"verse":6,"text":"Iob 16.22. psal.90.6 and 102.11 and 103.15. and144.4. isa.40.6. iam.4.14"},{"verse":7,"text":"Hebr. shall not returne. , To see, that is, to enioy."},{"verse":8,"text":"That is, I can liue no longer."},{"verse":15,"text":"Heb. then my bones."},{"verse":17,"text":"Psal.8.4. and 144.3. heb.2.6."}]