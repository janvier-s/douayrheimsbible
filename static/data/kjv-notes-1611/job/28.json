[{"verse":1,"text":"Or, a mine."},{"verse":2,"text":"Or, dust."},{"verse":6,"text":"Or, goldoare."},{"verse":9,"text":"Or, flint."},{"verse":11,"text":"Heb. from weeping."},{"verse":14,"text":"Rom.11. 22,34."},{"verse":15,"text":"Heb. fine gold shall not be giuen for it. , Pro.3.14. and 8.11, 19. and 16.16."},{"verse":17,"text":"Or vessell of fine gold."},{"verse":18,"text":"Or, Ramoth."},{"verse":20,"text":"Vers.12."},{"verse":21,"text":"Or, heauen."},{"verse":27,"text":"Or, did number it."},{"verse":28,"text":"Psal.111. 10 prou.1. 7&9,10."}]