[{"verse":2,"text":"Or, for thy sake. , Eze.16.8. cha. 12. 14."},{"verse":6,"text":"Isai.63.9, 11,13. ose. 13.4."},{"verse":7,"text":"Psal.78. 58. and 106.38."},{"verse":8,"text":"Rom.2.20"},{"verse":10,"text":"Or, ouer to."},{"verse":11,"text":"Cha. 16.20"},{"verse":13,"text":"Chap. 17. 13. & 18.14 psal.36.9."},{"verse":14,"text":"Heb. become a spoile."},{"verse":15,"text":"Heb. gaue out their voyce."},{"verse":16,"text":"Or, feede on thy crown, deut. 33.12 Isai. 8.8."},{"verse":19,"text":"Isai.3.9. os.5.5."},{"verse":20,"text":"Or, serue. , Isai. 57.5,7. , Ier.3.6."},{"verse":21,"text":"Matth.21.23. mar.12.1. luc.20.9. , Exod.15.17. psal.44.3. and 80.9. Isai.5.2."},{"verse":22,"text":"Iob. 9.30."},{"verse":23,"text":"Or, O swift dromedarie."},{"verse":24,"text":"Or, O wild asse &c. , Heb. taught , Heb. the desire of her heart. , Or, reuerse it."},{"verse":25,"text":"Or, is the case desperate?"},{"verse":27,"text":"Or, begotten me. , Heb. the hinder part part of the necke. , Isai. 26. 16."},{"verse":28,"text":"Isai. 45. 20. , Heb. euill. , Chap. 11. 13."},{"verse":30,"text":"IsaiI.9. 13. cha. 5. 3 , Matth.23. 29. &c."},{"verse":31,"text":"Chap.2.5 , Heb. we haue dominion."},{"verse":34,"text":"Heb. digging."}]