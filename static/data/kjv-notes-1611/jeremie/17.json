[{"verse":1,"text":"Iob.19. 24. , Heb. naile:"},{"verse":2,"text":"Iudg.3.7. Isai.1.29."},{"verse":3,"text":"Chap.15. 13."},{"verse":4,"text":"Heb. in thy selfe."},{"verse":7,"text":"Psal.2.12. and 34.10. and 125.1. prou.16. 20. isa.30. 18."},{"verse":8,"text":"Psal.1.3. , Or, restraint."},{"verse":10,"text":"2.Sam.16. 7. psal.7.10. chap.11.20 and 20. 12."},{"verse":11,"text":"Or, gathereth young which shee hath not brought forth."},{"verse":13,"text":"Psal.73. 25. isa.1.28 , Chap.2.3"},{"verse":15,"text":"Isa.5.19."},{"verse":16,"text":"Heb. after thee. , Chap.1.4, &c."},{"verse":18,"text":"Psal.35.4 and 40.15. , Heb. break them with a double breach. , Cha.11.20"},{"verse":21,"text":"Nehe.13. 19."},{"verse":22,"text":"Exo.20.8. and 23. 12. and 31. 13. exe.20. 12."},{"verse":25,"text":"Cha. 22.8"}]