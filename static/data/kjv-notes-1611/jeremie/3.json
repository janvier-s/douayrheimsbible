[{"verse":1,"text":"Heb. saying. , Deu.24.4"},{"verse":3,"text":"Deut.28.24. chap.9. 12. , Cha.6.15."},{"verse":6,"text":"Cha.2.20."},{"verse":9,"text":"Or, fame."},{"verse":10,"text":"Hebr. in falshood."},{"verse":12,"text":"Psal.86. 15. and 103 8,9."},{"verse":15,"text":"Cha.23.4."},{"verse":16,"text":"Heb. come vp on the heart. , Or, it be magnified."},{"verse":17,"text":"Or, stubburnnesse."},{"verse":18,"text":"Or, to. , Or, caused your fathers to possesse."},{"verse":19,"text":"Heb. land of desire. , Heb. land of desire. , Hebr. from after me."},{"verse":20,"text":"Heb. friend"},{"verse":22,"text":"Ose. 14.2."}]