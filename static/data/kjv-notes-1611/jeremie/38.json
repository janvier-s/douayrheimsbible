[{"verse":2,"text":"Cha.21.9"},{"verse":4,"text":"Heb. peace."},{"verse":6,"text":"Or, of the king."},{"verse":9,"text":"Hebr. he will die."},{"verse":10,"text":"Hebr. in thine hand."},{"verse":14,"text":"Or principall."},{"verse":22,"text":"Hebr. men of thy peace."},{"verse":23,"text":"Hebr. thou shalt burne, &c."},{"verse":27,"text":"Hebr. they were silent from him."}]