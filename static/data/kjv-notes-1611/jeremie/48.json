[{"verse":1,"text":"Or, the hie place."},{"verse":2,"text":"Or, bee brought to silence. , Heb. goe after thee."},{"verse":5,"text":"Heb. weeping with weeping. , Isai.15.5."},{"verse":6,"text":"Or, a naked tree. , Cha.17.6."},{"verse":7,"text":"Cha.49.5."},{"verse":10,"text":"Or, negligently."},{"verse":11,"text":"Heb. stood."},{"verse":14,"text":"1. Kings 12.29."},{"verse":15,"text":"Heb. the choice of."},{"verse":19,"text":"Heb. inhabitresse."},{"verse":20,"text":"Isai. 16.7."},{"verse":27,"text":"Or, moouedst thy selfe."},{"verse":29,"text":"Isai. 16.6. &c."},{"verse":30,"text":"Or, those on whom hee stayeth (heb. his barres) do not right."},{"verse":33,"text":"Isai. 16.10."},{"verse":34,"text":"Isai. 15. 5,6. , Heb. desolations."},{"verse":37,"text":"Isai. 15. 2,3. , Heb. diminished."},{"verse":39,"text":"Heb. necke."},{"verse":41,"text":"Or, the cities."},{"verse":43,"text":"Isai. 24. 17,18."},{"verse":45,"text":"Num. 21. 28. , Heb. children of noise."},{"verse":46,"text":"Heb. in captiuitie."}]