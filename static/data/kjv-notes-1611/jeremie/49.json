[{"verse":1,"text":"Or, against. , Or, Melcom. , Amos 1. 13."},{"verse":2,"text":"Amos. 1. 14."},{"verse":3,"text":"Or, Melcom. , Chap.48. 7."},{"verse":4,"text":"Or, thy valley floweth away."},{"verse":7,"text":"Obad.ver.8."},{"verse":8,"text":"Or, they are turned backe."},{"verse":9,"text":"Obad. ver. 5. , Heb. their sufficiencie."},{"verse":14,"text":"Obad.ver.1."},{"verse":16,"text":"Obad. ver. 4."},{"verse":17,"text":"Chap. 50 13."},{"verse":18,"text":"Gen. 19. 25. chap. 50 40."},{"verse":19,"text":"Or, conuent me in iudgement. , Iob. 21.1. chap. 50. 44,45."},{"verse":21,"text":"Heb. weedie Sea."},{"verse":23,"text":"Heb. melted. , Or, as on the Sea."},{"verse":27,"text":"Amos 1.4."},{"verse":30,"text":"Verse 8. , Heb. flit greatly."},{"verse":31,"text":"Or, that is at ease."},{"verse":32,"text":"Heb. cut off into corners, or that haue the corners of their haire polled."},{"verse":39,"text":"Chap. 49. 6. and 48. 47."}]