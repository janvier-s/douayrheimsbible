[{"verse":1,"text":"Chap.22.24. 2.kings 24.17. and 2.chron. 36 10."},{"verse":2,"text":"Heb. by the hand of the prophet."},{"verse":9,"text":"Heb. soules"},{"verse":10,"text":"Heb. thrust through."},{"verse":11,"text":"Heb. made to ascend."},{"verse":12,"text":"Or, to slip away from thence in the midst of the people."},{"verse":14,"text":"Heb. falsehood or lie."},{"verse":16,"text":"Or, Celles."},{"verse":20,"text":"Heb. let my supplication fall."}]