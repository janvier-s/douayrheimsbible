[{"verse":3,"text":"Or, frames or seates."},{"verse":4,"text":"Or, that he made, was marred as clay in the hand of the potter. , Hebr. returned and made."},{"verse":6,"text":"Isa.45. 9. rom.9. 10. wisd.15.7."},{"verse":7,"text":"Chap.1. 10."},{"verse":8,"text":"Iona.3.10."},{"verse":11,"text":"2. Kin. 17.13. chap. 7. 3. and 25.5. and 35.15."},{"verse":12,"text":"Chap. 2. 25."},{"verse":13,"text":"Chap. 2. 10."},{"verse":14,"text":"Or, my fields for a rocke, or for the snow of Lebanon? Shall the running waters be forsaken for the strange cold waters? , Cha.2.13."},{"verse":15,"text":"Chap.17. 13. , Chap.6. 16."},{"verse":16,"text":"Chap.19. 8. and 49. 13. and 50. 13."},{"verse":18,"text":"Mal. 2.7. , Or, for the tongue."},{"verse":21,"text":"Heb. powre them out. , Psal.109. 10."},{"verse":23,"text":"Hebr. for death."}]