[{"verse":1,"text":"Eccles.7.2 , Or, fauour is better then, &c."},{"verse":2,"text":"Chap. 29. 13."},{"verse":3,"text":"Chap.27. 12."},{"verse":4,"text":"Psal. 112. 13. , Or, the reward of humilitie, &c."},{"verse":6,"text":"Or, catechize. , Heb. in his way."},{"verse":7,"text":"Heb. to the man that lendeth."},{"verse":8,"text":"Iob 4.8. hos.10.13. , Or, and with the rod of his anger he shalbe consumed."},{"verse":9,"text":"2.Cor.9.6 , Heb. good of eye."},{"verse":10,"text":"Psal.101.6"},{"verse":11,"text":"Or, and hath grace in his lips."},{"verse":12,"text":"Or, the matters."},{"verse":13,"text":"Chap. 26. 13."},{"verse":14,"text":"Chap. 2. 16. and 23. 27. and 5.3. and 7.5."},{"verse":15,"text":"Chap. 13. 24. and 19. 18. and 23. 13. and 29. 15, 17."},{"verse":18,"text":"Heb. in thy belly."},{"verse":19,"text":"Or, trust thou also."},{"verse":21,"text":"Or, to those that send thee."},{"verse":22,"text":"Zach.7.10"},{"verse":23,"text":"Chap. 23. 11. iob.31. 21."},{"verse":26,"text":"Chap.6.1. and 11. 15."},{"verse":28,"text":"Chap. 13. 10. deut. 19 14. & 27.7. , Or, bound."},{"verse":29,"text":"Heb. obscure men."}]