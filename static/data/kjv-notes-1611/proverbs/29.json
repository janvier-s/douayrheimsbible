[{"verse":1,"text":"Heb. a man of reproofes."},{"verse":2,"text":"Chap. 11. 10. and 28. 28. eccles. 10.5. , Or, increased."},{"verse":3,"text":"Chap. 10. 1. and 15. 20. and 27. 11. , Luk.15. 13.chap. 5. 9. and 28.7."},{"verse":4,"text":"Heb. a man of oblations."},{"verse":7,"text":"Iob 29. 16."},{"verse":8,"text":"Or, set a citie on fire."},{"verse":10,"text":"Heb. men of blood."},{"verse":13,"text":"Cha.22.2. , Or, the vsurer."},{"verse":14,"text":"Chap. 20. 28."},{"verse":15,"text":"See ver. 17 , Chap. 10. 1. and 17.21 and 25."},{"verse":16,"text":"Psal. 37. 36. and 58 11. and 91.8"},{"verse":17,"text":"Chap. 13. 24. and 22. 15. and 23. 13, 14"},{"verse":18,"text":"Or, is made naked."},{"verse":20,"text":"Or, in his matters."},{"verse":22,"text":"Chap.15. 18. & 26.21"},{"verse":23,"text":"Chap. 15. 33. and 18. 12. iob 22.29. luk.14. 11. mat. 23. 12."},{"verse":25,"text":"Heb. shalbe set on high."},{"verse":26,"text":"Cha. 19.6 , Hebr. the face of a ruler."}]