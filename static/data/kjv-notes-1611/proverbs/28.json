[{"verse":1,"text":"Leuit.26. 36."},{"verse":2,"text":"Or, by men of vnderstanding and wisedome shall they likewise be prolonged."},{"verse":3,"text":"Heb. without foode."},{"verse":6,"text":"Cha.19.1."},{"verse":7,"text":"Cha.29.3. , Or, feedeth gluttons."},{"verse":8,"text":"Chap. 13. 22. eccles.2 26. , Hebr. by increase."},{"verse":10,"text":"Chap.26. 27."},{"verse":11,"text":"Heb. in his eyes."},{"verse":12,"text":"Iohn 11.10 eccles.10.6 and ver. 28. , Or, sought for."},{"verse":13,"text":"Psal. 32.5. 1.ioh.1.9. and 10."},{"verse":14,"text":"Rom.11. 20."},{"verse":17,"text":"Gen. 9.6. exod.21. 14"},{"verse":18,"text":"Chap.10. 25."},{"verse":19,"text":"Chap.12. 11."},{"verse":20,"text":"Chap. 13. 11. and 23. 4. 1.tim.6.9 , Or, vnpunished."},{"verse":21,"text":"Chap. 18. 5. & 24.23."},{"verse":22,"text":"Or, he that hath an euill eye, hasteth to be rich, ver, 20."},{"verse":23,"text":"Cha.27.6."},{"verse":24,"text":"Heb. a man destroying."},{"verse":25,"text":"Chap.13. 10."},{"verse":27,"text":"Deut. 15. 8. cha.22.9."},{"verse":28,"text":"Chap. 29. 2. and ver. 12.of this chapter."}]