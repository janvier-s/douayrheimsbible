[{"verse":5,"text":"Hebr. alter. , Hebr. of all the sonnes of affliction."},{"verse":6,"text":"Psal. 104. 15. , Hebr. bitter of soule."},{"verse":8,"text":"Hebr. the sonnes of destruction."},{"verse":9,"text":"Leuit. 19. 15. deut. 1. 16."},{"verse":10,"text":"Chap. 12. 4."},{"verse":16,"text":"Hebr. taketh."},{"verse":18,"text":"Hebr. she tasteth."},{"verse":20,"text":"Hebr she spreadeth."},{"verse":21,"text":"Or, double garments."},{"verse":29,"text":"Or, haue gotten riches."}]