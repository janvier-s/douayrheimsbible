[{"verse":3,"text":"Chap. 10. 13. psal. 32.9."},{"verse":5,"text":"Heb. his owne eyes."},{"verse":6,"text":"Or, violence."},{"verse":7,"text":"Heb. are lifted vp."},{"verse":8,"text":"Or, as he that putteth a pretious stone in an heape of stones."},{"verse":10,"text":"Or, a great man grieueth all, and hee hireth the foole, he hireth also transgressors."},{"verse":11,"text":"2.Pet.2. 22. , Heb. iterateth his folly."},{"verse":13,"text":"Chap. 22. 13."},{"verse":15,"text":"Chap.19. 24. , Or he is weary."},{"verse":17,"text":"Or, is enraged."},{"verse":18,"text":"Heb. flames or sparkes."},{"verse":20,"text":"Heb. without wood. , Chap. 22. 10. , Or, whisperer. , Heb. is silent."},{"verse":21,"text":"Chap.15. 18. & 29.22."},{"verse":22,"text":"Cha.18.8 , Heb. chambers."},{"verse":24,"text":"Or, is knowen."},{"verse":25,"text":"Heb. maketh his voice gracious."},{"verse":26,"text":"Or, hatred is couered in secret."},{"verse":27,"text":"Eccles.10. 5. psal.17. 16. & 9.15."}]