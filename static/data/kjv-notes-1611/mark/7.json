[{"verse":1,"text":"Matth.15 1."},{"verse":2,"text":"Or, common."},{"verse":3,"text":"Or, diligently, in the Originall, with the fist: Theophilact, vp to the elbowe."},{"verse":4,"text":"Or, beds. , Sextarius, is about a pinte and an halfe."},{"verse":6,"text":"Esai.29.13. mat.15.8."},{"verse":9,"text":"Or, frustrate."},{"verse":11,"text":"Matth. 15.5."},{"verse":14,"text":"Matt. 15.10."},{"verse":21,"text":"Gen.6.5. and 8.21."},{"verse":22,"text":"Matth. 15.19."},{"verse":24,"text":"Matt. 15.21."},{"verse":26,"text":"Or, Gentile."}]