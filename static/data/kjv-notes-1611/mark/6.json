[{"verse":1,"text":"Mat.13.54."},{"verse":4,"text":"Iohn 4.4."},{"verse":6,"text":"Mat.9.35 luke 13.22."},{"verse":7,"text":"Mat.10.1."},{"verse":8,"text":"The word signifieth a piece of brasse money, in value somewhat lesse then a farthing, mat. 10.9. but here it is taken in generall for mony."},{"verse":11,"text":"Mat.10.14 , Act.13.51"},{"verse":13,"text":"Iam.5.14."},{"verse":14,"text":"Mat.14.1"},{"verse":16,"text":"Luk.3.19"},{"verse":18,"text":"Leuit.18.16."},{"verse":19,"text":"Or, an inward grudge"},{"verse":20,"text":"Or, kept him or saued him."},{"verse":27,"text":"Or, one of his guard."},{"verse":30,"text":"Luk.9.10"},{"verse":32,"text":"Mat.14.13."},{"verse":34,"text":"Mat.6.39."},{"verse":35,"text":"Matth. 14.15."},{"verse":37,"text":"The Rom. penie is seuen pence halfe penie as Mat.18.28"},{"verse":45,"text":"Or, ouer against Bethsaida."},{"verse":47,"text":"Matth.14.23."},{"verse":53,"text":"Matth.14.34."},{"verse":56,"text":"Or, it."}]