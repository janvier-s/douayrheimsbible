[{"verse":1,"text":"2.king.18 13,&c. esai. 36.1,&c. , Hebr. to breake them vp."},{"verse":2,"text":"Heb. his face was to warre."},{"verse":4,"text":"Heb. ouerflowed."},{"verse":5,"text":"Or, swords, or weapons."},{"verse":6,"text":"Heb. hee spake to their heart."},{"verse":8,"text":"Iere.17.5. , Heb. leaned."},{"verse":9,"text":"2.King. 18.17. , Heb. dominion."},{"verse":10,"text":"Or, in the strong hold."},{"verse":21,"text":"2.King.19.35,&c. , Heb. made him fall."},{"verse":23,"text":"Heb. pretious things."},{"verse":24,"text":"2.King.20. 1.isai.38.1. , Or, wroght a miracle for him."},{"verse":26,"text":"Heb. the lifting vp."},{"verse":27,"text":"Hebr. instruments of desire."},{"verse":31,"text":"Heb. interpreters. , 2.King. 20.12. isa. 39.1."},{"verse":32,"text":"Hebr. kindnesses."},{"verse":33,"text":"Or, highest."}]