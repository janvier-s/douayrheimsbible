[{"verse":1,"text":"2.King. 23. 30. &c."},{"verse":3,"text":"Hebr. remooued him. , Hebr. mulcted."},{"verse":6,"text":"Or, chaines."},{"verse":7,"text":"2.King. 24.13. dan. 1.1,2."},{"verse":8,"text":"Or, Ieconiah,1.chro. 3.16. or, Coniah, ier.22. 24."},{"verse":9,"text":"2.King. 24.8."},{"verse":10,"text":"Hebr. at the returne of the yeere. , Heb. vessels of desire. , Or, Mattaniah, 2.kin. 24.17. ier. 37.1."},{"verse":11,"text":"Ier.52.1, &c. 2.king 24.18."},{"verse":15,"text":"Ier.25.3. and 35.15. , Heb. by the hand of his messengers. , That is, continually and carefully"},{"verse":16,"text":"Heb. healing."},{"verse":17,"text":"2.Kings 25.1, &c."},{"verse":20,"text":"Heb. the remainder from the sword."},{"verse":21,"text":"Ier.25.9, 12. & 29.10 , Leuit.26. 34. and 35. and 43."},{"verse":22,"text":"Ezra 1.1. , Ier.25.12 13. and 29. 10."}]