[{"verse":1,"text":"2.King. 14.21. and 15.1. , Or, Azariah."},{"verse":5,"text":"Hebr. in the seeing of God."},{"verse":6,"text":"Or, in the countrey of Ashdod."},{"verse":8,"text":"Heb. went."},{"verse":9,"text":"Or, repaired."},{"verse":10,"text":"Or, cut out many cisterues. , Or, fruitfull fields. , Hebr. ground."},{"verse":13,"text":"Hebr. the power of an armie."},{"verse":14,"text":"Heb. stones of slings."},{"verse":15,"text":"Heb. went foorth."},{"verse":18,"text":"Num.18.7 , Exo.30.7"},{"verse":20,"text":"As Ester 6 12."},{"verse":21,"text":"2.Kings 15.5. , Leuit.13. 46. , Heb. free."}]