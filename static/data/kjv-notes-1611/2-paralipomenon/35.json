[{"verse":1,"text":"2.King. 23.21,22. , Exo.12.6."},{"verse":4,"text":"1.Chron. 9.10. and chap.23, 24.25, and 26. , 2. Chron. 8.14."},{"verse":5,"text":"Heb. the house of the fathers. , Heb. the sonnes of the people."},{"verse":7,"text":"Heb. offred"},{"verse":8,"text":"Heb. offred."},{"verse":9,"text":"Heb. offred."},{"verse":11,"text":"See Chap. 29.34."},{"verse":13,"text":"Exod. 12. 8,9. , Heb. made them runne."},{"verse":15,"text":"Heb. station , 1.Chron. 25.1,&c. , 1.Chron. 9.17. and 26.14."},{"verse":17,"text":"Heb. found."},{"verse":20,"text":"2.King. 23.29. , Heb. house."},{"verse":21,"text":"Hebr. the house of my warre."},{"verse":23,"text":"Hebr. made sicke."},{"verse":24,"text":"Or, among the sepulchres. , Zach.12. 11."},{"verse":26,"text":"Hebr. kindnesses."}]