[{"verse":2,"text":"1.King.7. 23. &c. , Hebr. from his brim, to his brim."},{"verse":3,"text":"1.King. 7. 24."},{"verse":5,"text":"Or, like a Lillie flower."},{"verse":6,"text":"Hebr. the worke of burnt offering."},{"verse":8,"text":"Or, bowles."},{"verse":11,"text":"Or, bowles. , Hebr. finished to make."},{"verse":13,"text":"Hebr. vpon the face."},{"verse":14,"text":"Or, caldrons."},{"verse":16,"text":"Heb. made bright, or scoured."},{"verse":17,"text":"Heb. thicknesses of the ground."},{"verse":21,"text":"Hebr. perfections of gold."},{"verse":22,"text":"Or, bowles."}]