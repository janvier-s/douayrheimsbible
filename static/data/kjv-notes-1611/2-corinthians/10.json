[{"verse":1,"text":"Or, in outward appearance."},{"verse":2,"text":"Or, reckon."},{"verse":4,"text":"Or, to God."},{"verse":5,"text":"Or, reasonings."},{"verse":12,"text":"Or, vnderstand it not."},{"verse":13,"text":"Or, line."},{"verse":15,"text":"Or, magnified in you."},{"verse":16,"text":"Or, rule."},{"verse":17,"text":"Iere.9.24. 1.cor. 1.31"}]