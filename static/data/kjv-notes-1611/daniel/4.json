[{"verse":2,"text":"Cald. it was seemely before me."},{"verse":3,"text":"Chap.2. 34."},{"verse":9,"text":"Cha. 1.48."},{"verse":10,"text":"Cald. I was seeing."},{"verse":14,"text":"Cald. with might."},{"verse":25,"text":"Chap.5. 20. &c."},{"verse":27,"text":"Or, an healing of thine errour."},{"verse":29,"text":"Or, vpon."},{"verse":34,"text":"Chap.7 14. mic.4.7 luc.1.33."},{"verse":35,"text":"Iob.9.12. isai.45.9."}]