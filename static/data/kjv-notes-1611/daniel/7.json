[{"verse":1,"text":"Cald. saw. , Or, words."},{"verse":4,"text":"Or, wherewith."},{"verse":5,"text":"Or, it raised vp one dominion."},{"verse":10,"text":"Reu.5.11. , Reu.22. 12."},{"verse":12,"text":"Cald. a prolonging in life was giuen them."},{"verse":14,"text":"Chap.2. 44. mic.4. 7. luc.1. 33."},{"verse":15,"text":"Cald. sheath."},{"verse":18,"text":"Cald. high ones, i. things or, places."},{"verse":19,"text":"Cald. from all those."},{"verse":27,"text":"Luc.1.33. , Or, rulers."}]