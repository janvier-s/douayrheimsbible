[{"verse":1,"text":"Heb. great."},{"verse":2,"text":"Heb. weeks of dayes."},{"verse":3,"text":"Heb. bread of desires."},{"verse":4,"text":"Gen.2.14."},{"verse":5,"text":"Heb. one man. , Reu.1. 13,14,15."},{"verse":8,"text":"Or, vigor. , Dan.7.28."},{"verse":10,"text":"Heb. mooued."},{"verse":11,"text":"Heb. a man of desires. , Heb. stand vpon thy standing."},{"verse":13,"text":"Or, the first."},{"verse":17,"text":"Or, this seruant of my Lord."},{"verse":21,"text":"Heb. strengtheneth himselfe."}]