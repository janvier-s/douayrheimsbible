[{"verse":1,"text":"Hebr. the sonnes of the transportation."},{"verse":6,"text":"Heb. Ahashuerosh."},{"verse":7,"text":"Or, in peace. , Heb. societies."},{"verse":8,"text":"Or, Secretarie."},{"verse":9,"text":"Chald. societies."},{"verse":10,"text":"Chal. Cheeneth."},{"verse":12,"text":"Or, finished , Chal. sowed together."},{"verse":13,"text":"Chal. giue. , Or, strength."},{"verse":14,"text":"Chal. we are salted with the salt of the palace."},{"verse":15,"text":"Cald. made. , Chald. in the midst thereof."},{"verse":17,"text":"Chal, societies."},{"verse":19,"text":"Chald. by me a decree is set. , Chald. listed vp it selfe."},{"verse":21,"text":"Chal. make a decree."},{"verse":23,"text":"Chald. by arme and power."}]