[{"verse":16,"text":"Or, full of idoles."},{"verse":18,"text":"Or, base fellow."},{"verse":19,"text":"Or, Mars-hill: It was the highest court in Athens."},{"verse":22,"text":"Or, court of the Areopagites."},{"verse":23,"text":"Or, gods that you worship, 2. Thess. 2. 4."},{"verse":24,"text":"Cha. 7.48."},{"verse":25,"text":"Psal.50.8."},{"verse":29,"text":"Esai 40.18"},{"verse":31,"text":"Or, offered faith."}]