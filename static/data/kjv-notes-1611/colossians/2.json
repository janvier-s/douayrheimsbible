[{"verse":1,"text":"Or, feare or care."},{"verse":3,"text":"Or, wherein."},{"verse":8,"text":"Or, elements."},{"verse":15,"text":"Or, in himselfe."},{"verse":16,"text":"Or, for eating and drinking. , Or, in part."},{"verse":18,"text":"Or, iudge against you. , Gr. being a voluntary. in humilitie."},{"verse":20,"text":"Or, elements."},{"verse":23,"text":"Or, punishing, or not sparing."}]