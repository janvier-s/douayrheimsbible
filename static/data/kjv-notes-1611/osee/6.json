[{"verse":2,"text":"1.Cor.15. 4."},{"verse":4,"text":"Or, mercy, or, kindnesse."},{"verse":5,"text":"Or, that thy iudgements might be, &c."},{"verse":6,"text":"Matth.9. 13. and 10. 7. eccles. 4. 17. 1.sam. 15.22."},{"verse":7,"text":"Or, like Adam."},{"verse":8,"text":"Or, cunning for blood."},{"verse":9,"text":"Hebr. with one shoulder. Or, to Sichem. , Or, enormitie."}]