[{"verse":1,"text":"That is, my people. , That is, hauing obtained mercy."},{"verse":2,"text":"Isai.50.1. , Eze.16.25"},{"verse":3,"text":"Eze.16.4."},{"verse":5,"text":"Heb. drinks"},{"verse":6,"text":"Heb. wall a wall."},{"verse":8,"text":"Heb. new wine. , Or, wherewith they made Baal."},{"verse":9,"text":"Or, take away."},{"verse":10,"text":"Heb. folly or villanie."},{"verse":12,"text":"Heb. make desolate."},{"verse":14,"text":"Or, friendly. Heb. to her heart."},{"verse":16,"text":"That is, my husband. , That is, my Lord."},{"verse":18,"text":"Iob.5. 23."},{"verse":23,"text":"Rom.9. 26. 1.pet.2. 10."}]