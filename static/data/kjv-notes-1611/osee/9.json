[{"verse":1,"text":"Iere. 44. 17. , Or, in, &c."},{"verse":2,"text":"Or, winefat."},{"verse":6,"text":"Heb. spoile. , Or, their siluer shall be desired, the nettle &c: Heb. the desire."},{"verse":7,"text":"Heb. man of the spirit."},{"verse":8,"text":"Or, against"},{"verse":9,"text":"Iudg.19. 18."},{"verse":10,"text":"Num.25. 3."},{"verse":14,"text":"Heb. that casteth the fruite."},{"verse":15,"text":"Chap. 12. 11."},{"verse":16,"text":"Heb. the desires."}]