[{"verse":1,"text":"2. Chron. 34.30."},{"verse":2,"text":"Hebr. from small euen vnto great."},{"verse":5,"text":"Heb. caused to cease. , Heb. Chemarim. , Or, twelue signes or constellations."},{"verse":6,"text":"Cha. 21.7"},{"verse":7,"text":"Heb. houses"},{"verse":11,"text":"Or, Eunuch, or Officer."},{"verse":12,"text":"Cha. 21.5 , Or, ran from thence."},{"verse":13,"text":"That is, the mount of Oliues. , 1. King. 11.7."},{"verse":14,"text":"Heb. statues."},{"verse":16,"text":"1. King 13.2."},{"verse":18,"text":"Hebr. to escape."},{"verse":20,"text":"Or sacrificed."},{"verse":21,"text":"2. Chron. 35.1. 1.esd. 1.1. , Exo. 12.3 deut. 16.2."},{"verse":24,"text":"Or, Teraphim. , Leuit. 20.27. deut. 18.11."},{"verse":26,"text":"Heb. angers."},{"verse":27,"text":"1.King.8.29. & 9.3. Chap. 21.7."},{"verse":29,"text":"2. Chron. 35.20."},{"verse":30,"text":"2. Chron. 36.1."},{"verse":33,"text":"Or, because he reigned. , Heb. set a mulct vpon the land."},{"verse":34,"text":"Matth. 1.12. called Iakim."}]