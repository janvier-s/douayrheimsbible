[{"verse":2,"text":"Ier.49. 1. &c."},{"verse":4,"text":"Heb. children."},{"verse":6,"text":"Heb. hand. , Heb. foote , Heb. soule."},{"verse":7,"text":"Or, meate."},{"verse":8,"text":"Ier.48.1, &c."},{"verse":9,"text":"Heb. shoulder of Moab"},{"verse":10,"text":"Or, against the children of Ammon."},{"verse":12,"text":"Heb. by reuenging reuengement."},{"verse":13,"text":"Or, they shall fall by the sword vnto Dedan."},{"verse":15,"text":"Or, with perpetuall hatred."},{"verse":16,"text":"Or, hauen of the Sea."},{"verse":17,"text":"Heb. vengeances."}]