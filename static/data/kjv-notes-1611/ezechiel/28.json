[{"verse":2,"text":"Heb. heart. , Isai.31. 13."},{"verse":5,"text":"Heb. by the greatnesse of thy wisedome."},{"verse":9,"text":"Or, woundeth."},{"verse":13,"text":"Or, ruby. , Or, chrysolite. , Or, Chysoprase."},{"verse":19,"text":"Heb. terrours."},{"verse":26,"text":"Or, with confidence. , Or, spoile."}]