[{"verse":1,"text":"Cha.1.22."},{"verse":2,"text":"Heb. the hollow of thine hand."},{"verse":4,"text":"Hebr. was lifted vp."},{"verse":5,"text":"Chap.1. 24."},{"verse":7,"text":"Hebr. sent foorth."},{"verse":9,"text":"Chap.1. 16."},{"verse":12,"text":"Hebr. flesh."},{"verse":13,"text":"Or, they were called in my hearing, wheele, or Galgal."},{"verse":17,"text":"Or, of life."}]