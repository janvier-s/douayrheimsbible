[{"verse":3,"text":"Hebr. perfit of beautie."},{"verse":4,"text":"Hebr. heart."},{"verse":5,"text":"Hebr. built."},{"verse":6,"text":"Or, they haue made hatches of Yuorie well troden. , Heb. the daughter."},{"verse":7,"text":"Or, purple and scarlet."},{"verse":9,"text":"Or, stoppers of chinks. Heb. strengthners."},{"verse":13,"text":"Or, merchandise."},{"verse":16,"text":"Hebr. workes. , Or, Chrysoprase."},{"verse":17,"text":"Or, rosin."},{"verse":19,"text":"Or, Meuzall."},{"verse":20,"text":"Hebr. clothes of freedome."},{"verse":21,"text":"Heb. they were the merchants of thy hand."},{"verse":24,"text":"Or, excellent things. , Heb. foldings."},{"verse":26,"text":"Heb. heart."},{"verse":27,"text":"Reu. 18. 9,&c. , Or, euen withall. , Or, heart."},{"verse":28,"text":"Or, waues."},{"verse":36,"text":"Heb. terrours. , Heb. shalt not be for euer."}]