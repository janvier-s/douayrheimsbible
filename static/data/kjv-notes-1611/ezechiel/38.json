[{"verse":2,"text":"Reu. 20.8. , Or prince of the chiefe."},{"verse":4,"text":"Cha. 39.2."},{"verse":5,"text":"Or. Phut."},{"verse":10,"text":"Or, conceiue a mischieuous purpose."},{"verse":11,"text":"Or, confidently."},{"verse":12,"text":"Heb. to spoile the spoile, and to praye the praye. , Heb. nauell."},{"verse":17,"text":"Heb. by the hands."},{"verse":20,"text":"Or, towres. Or staires."},{"verse":23,"text":"Chap.36. 23. and 37. 28."}]