[{"verse":2,"text":"Hebr. let vs breake foorth and send. , Hebr. in the cities of their suburbs."},{"verse":3,"text":"Heb. bring about."},{"verse":5,"text":"1.Sam.7. 1. 2.sam.6.2."},{"verse":6,"text":"Iosh.16.9."},{"verse":7,"text":"Heb. made the Arke to ride."},{"verse":8,"text":"Heb. songs."},{"verse":9,"text":"Called Nachon, 2.Sam. 6.6. , Or, shooke it."},{"verse":10,"text":"Num.4. 15."},{"verse":11,"text":"Heb. breach of Vzza."},{"verse":13,"text":"Hebr. remooued."},{"verse":14,"text":"As chap. 26.5."}]