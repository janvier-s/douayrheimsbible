[{"verse":1,"text":"Cha.22.5."},{"verse":4,"text":"1.king.9. 28."},{"verse":5,"text":"Hebr. to fill his hand."},{"verse":11,"text":"Mat.6.13 1.tim.1.17. apoc. 5.13."},{"verse":14,"text":"Hebr. retaine or obtain strength , Hebr. of thine hand."},{"verse":15,"text":"Psal.39.12 and 90.9. heb.11.13. 1.pet.2.11. , Hebr. expectation."},{"verse":17,"text":"Cha. 23.9 1.Sam.16.7 , Heb. found"},{"verse":18,"text":"Or, stablish"},{"verse":22,"text":"1.King.1. 33."},{"verse":24,"text":"Heb. gaue the hand vnder Solomon."},{"verse":25,"text":"1.King.3. 13. 2.chro.1.12. eccles. 2.9."},{"verse":29,"text":"Or, historie. , Hebr. words."}]