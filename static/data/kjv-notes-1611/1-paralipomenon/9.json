[{"verse":3,"text":"Nehem. 11.1."},{"verse":13,"text":"Heb. mightie men of valour."},{"verse":19,"text":"Heb. thresholds."},{"verse":22,"text":"Heb. founded. , Or, trust,"},{"verse":26,"text":"Or, trust. , Or, storehouses."},{"verse":28,"text":"Heb. bring them in by tale, and carie them out by tale."},{"verse":29,"text":"Or, vessels."},{"verse":30,"text":"Exod. 30. 23."},{"verse":31,"text":"Or, trust. , Or, on flat plates, or, slices."},{"verse":32,"text":"Heb. bread of ordering."},{"verse":33,"text":"Hebr. vpon them."},{"verse":35,"text":"Chap.8. 29."},{"verse":39,"text":"1.Chro.8. 33."},{"verse":41,"text":"Chap.8. 35."}]