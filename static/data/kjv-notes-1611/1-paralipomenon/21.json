[{"verse":1,"text":"Sam.24. 1, &c."},{"verse":7,"text":"And it was euill in the eyes of the LORD concerning this thing."},{"verse":8,"text":"2.Sam. 24.10."},{"verse":10,"text":"Hebr. stretch out."},{"verse":11,"text":"Hebr. take to thee."},{"verse":13,"text":"Or, many."},{"verse":15,"text":"2. Sam. 24.16. , Or, Araunah. 2.sam. 24.18."},{"verse":18,"text":"2.Chron. 3.1."},{"verse":20,"text":"Or, when Ornan turned backe, and saw the Angel, then he and his foure sonnes with him, hid themselues."},{"verse":22,"text":"Heb. giue."},{"verse":25,"text":"2.Sam.24. 24."},{"verse":29,"text":"Chap.16. 39. 2.Chro. 1.3. 1.king. 3.4."}]