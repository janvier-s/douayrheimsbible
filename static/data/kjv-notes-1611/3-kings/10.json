[{"verse":1,"text":"2.Chron. 9. 1. mat.12 42. luke 11. 31."},{"verse":3,"text":"Heb. words"},{"verse":5,"text":"Heb. standing. , Or, Butlers"},{"verse":6,"text":"Heb. word. , Or, sayings"},{"verse":7,"text":"Heb. thou hast added wisedome and goodnes to the fame."},{"verse":12,"text":"Or, railes. Heb. a prop. , 2.Chron. 9.10."},{"verse":13,"text":"Hebr. according to the hand of king Solomon."},{"verse":15,"text":"Or, Captaines."},{"verse":17,"text":"Chap.7.2."},{"verse":19,"text":"Heb. on the hinder part thereof. , Heb. hands."},{"verse":20,"text":"Heb. so."},{"verse":21,"text":"Or, there was no siluer in them."},{"verse":22,"text":"Or, Elephants teeth."},{"verse":24,"text":"Heb. sought the face of."},{"verse":26,"text":"2.Chron. 1.14."},{"verse":27,"text":"Heb. gaue"},{"verse":28,"text":"2.Chron.1. 16. & 9.28. , Heb. and the going forth of the horses which was Solomons."},{"verse":29,"text":"Hebr. by their hand."}]