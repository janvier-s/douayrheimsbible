[{"verse":1,"text":"2.Chron. 10.1."},{"verse":2,"text":"Chap.11. 40."},{"verse":4,"text":"Chap.4.7"},{"verse":13,"text":"Heb. hardly."},{"verse":15,"text":"Chap.11. 11."},{"verse":18,"text":"Heb. strengthened himselfe."},{"verse":19,"text":"Or, fell away."},{"verse":20,"text":"Chap.11. 13."},{"verse":22,"text":"2. Chron. 11.2."},{"verse":28,"text":"Exod.32. 8."},{"verse":32,"text":"Or, went vp to the altar &c. , Or to sacrifice."},{"verse":33,"text":"Or, went vp to the altar &c. , Hebr. to burne incense."}]