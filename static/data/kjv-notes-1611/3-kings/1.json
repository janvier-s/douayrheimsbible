[{"verse":1,"text":"Hebr. entred into dayes."},{"verse":2,"text":"Heb. let them seeke. , Hebr. a damsell, a virgine. , Heb. be a cherisher vnto him."},{"verse":5,"text":"Heb. reigne"},{"verse":6,"text":"Heb. from his dayes."},{"verse":7,"text":"Heb. his words were with Ioab. , Heb. helped after Adonijah."},{"verse":9,"text":"Or, the well Rogel."},{"verse":11,"text":"2.Sam 3.4."},{"verse":14,"text":"Heb. fill vp."},{"verse":16,"text":"Heb. what to thee?"},{"verse":21,"text":"Hebr. sinners."},{"verse":25,"text":"Hebr, Let king Adoniiah liue."},{"verse":28,"text":"Hebr. before the king."},{"verse":33,"text":"Heb. which belongeth to me."},{"verse":40,"text":"Or, flutes."}]