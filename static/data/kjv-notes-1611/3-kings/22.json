[{"verse":1,"text":"1.Chron. 18.1, &c."},{"verse":3,"text":"Hebr. silent from taking it."},{"verse":4,"text":"2.King.3. 7."},{"verse":9,"text":"Or, Eunuch."},{"verse":10,"text":"Heb. floore."},{"verse":20,"text":"Or, deceiue."},{"verse":24,"text":"2. Chron. 18.23."},{"verse":25,"text":"Or, from chamber to chamber. Heb. chamber in a chamber."},{"verse":30,"text":"Or, when he was to disguise himselfe and enter into the battell."},{"verse":34,"text":"Heb. in his simplicitie. , Heb. ioynts and the brestplate. , Heb. made sicke."},{"verse":35,"text":"Hebr. ascended. , Heb. bosome."},{"verse":37,"text":"Heb. came."},{"verse":38,"text":"Chap. 21. 19."},{"verse":41,"text":"2. Chron. 20.31."},{"verse":48,"text":"Or, had ten ships."}]