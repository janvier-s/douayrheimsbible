[{"verse":2,"text":"Heb. heauie."},{"verse":4,"text":"Heb. hastie. , Or, elegantly."},{"verse":7,"text":"Or, when he speaketh against the poore in iudgement."},{"verse":8,"text":"Or, be established."},{"verse":10,"text":"Heb. days aboue a yere."},{"verse":12,"text":"Heb. the fields of desire."},{"verse":13,"text":"Or, burning vpon. &c."},{"verse":14,"text":"Or, clifts and watchtowers."},{"verse":16,"text":"Chap.29. 17."},{"verse":19,"text":"Or, and the citie shall be vtterly abased."}]