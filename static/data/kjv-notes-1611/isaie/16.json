[{"verse":1,"text":"Or, Petra: Hebr. a rocke."},{"verse":2,"text":"Or, a nest forsaken."},{"verse":3,"text":"Heb. bring."},{"verse":4,"text":"Heb. wringer. , Hebr. the treaders downe."},{"verse":5,"text":"Or, prepared. , Dan. 7. 14, 27. mic. 4.7. luke 1. 33."},{"verse":6,"text":"Iere.48. 29."},{"verse":7,"text":"Iere.48. 20. , Or, mutter."},{"verse":8,"text":"Or, plucked vp."},{"verse":9,"text":"Or, the alarme is fallen vpon, &c."},{"verse":10,"text":"Iere.48. 33."},{"verse":14,"text":"Or, not many."}]