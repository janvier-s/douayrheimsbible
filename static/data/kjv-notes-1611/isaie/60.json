[{"verse":1,"text":"Or, be enlightened: for thy light commeth."},{"verse":3,"text":"Reu.21. 24."},{"verse":4,"text":"Chap.49. 18."},{"verse":5,"text":"Or, noise of the Sea shalbe turned toward thee. , Or, wealth"},{"verse":6,"text":"Chap.61. 6."},{"verse":9,"text":"Gel. 4.26"},{"verse":11,"text":"Reue.21. 25. , Or, wealth"},{"verse":14,"text":"Reue.3. 9."},{"verse":19,"text":"Reue.21. 22. & 22.5."}]