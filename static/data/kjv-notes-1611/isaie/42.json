[{"verse":1,"text":"Mat.12. 18. , Mat.3.17. and 17.5. eph.1.6."},{"verse":3,"text":"Or, dimly burning. , Hebr. quench it."},{"verse":4,"text":"Heb. broken."},{"verse":6,"text":"Chap. 49. 5. luk.2. 32 acts.13.47."},{"verse":7,"text":"Chap.61. 1. , Luk.4. 18 heb.2.14,15 cha.9.2."},{"verse":8,"text":"Chap.48. 11."},{"verse":10,"text":"Hebr. the fulnesse thereof."},{"verse":13,"text":"Or, behaue himselfe mightily."},{"verse":14,"text":"Hebr. swallow or sup vp."},{"verse":16,"text":"Hebr. into straightnes."},{"verse":17,"text":"Psal.97.7. chap. 1. 29. and 44. 11. and 45. 16."},{"verse":20,"text":"Rom. 2. 2."},{"verse":21,"text":"Or, him."},{"verse":22,"text":"Or, in snaring all the yong men of them. , Hebr. a treading."},{"verse":23,"text":"Hebr. for the after time."}]