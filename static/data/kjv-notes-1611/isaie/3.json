[{"verse":3,"text":"Hebr. A man eminent in countenance. , Or, skilfull of speech."},{"verse":4,"text":"Eccles. 10. 16."},{"verse":7,"text":"Hebr. lift vp the hand. , Hebr. binder vp."},{"verse":9,"text":"Gen. 13. 13. and 18. 21. and 19. 5."},{"verse":11,"text":"Hebr. done to him."},{"verse":12,"text":"Or, they which call thee blessed. , Hebr. swallow vp."},{"verse":14,"text":"Or, burnt."},{"verse":16,"text":"Hebr. deceiuing with their eyes. , Or, tripping nicely."},{"verse":17,"text":"Heb. make naked."},{"verse":18,"text":"Or, networkes."},{"verse":19,"text":"Or, sweetballes. , Or, spangled ornaments."},{"verse":20,"text":"Heb. houses of the soule."},{"verse":25,"text":"Heb. might"},{"verse":26,"text":"Or, emptied: hebr. cleansed."}]