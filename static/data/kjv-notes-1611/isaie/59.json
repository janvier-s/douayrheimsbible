[{"verse":1,"text":"Num.11.23. chap.50.2."},{"verse":2,"text":"Or, haue made him hide."},{"verse":3,"text":"Chap. 1. 15."},{"verse":4,"text":"Iob. 15. 35. psal. 7. 15."},{"verse":5,"text":"Or, adders. , Or, that which is sprinkled is as if there brake out a viper."},{"verse":6,"text":"Iob.8.14, 15."},{"verse":7,"text":"Prou.1.15 rom.3.15. , Heb. breaking."},{"verse":8,"text":"Or, right."},{"verse":15,"text":"Or, is accounted mad , Heb. it was euill in his eyes."},{"verse":16,"text":"Chap. 63. 5."},{"verse":17,"text":"Ephes 6.17. 1.thes. 5.8."},{"verse":18,"text":"Chap.63. 7. , Heb. recompenses."},{"verse":19,"text":"Reu.12. 15. , Or, put him to flight."},{"verse":20,"text":"Rom.11. 26."}]