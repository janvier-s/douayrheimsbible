[{"verse":1,"text":"Hebr. decked."},{"verse":2,"text":"Reu. 19. 13."},{"verse":4,"text":"Chap. 34. 8."},{"verse":5,"text":"Chap. 59. 16."},{"verse":9,"text":"Deut.7. 7,8."},{"verse":10,"text":"Exod. 15. 24. num.14. 11. psal.78. 57. and 95.9."},{"verse":11,"text":"Exod.14. 30. , Or, shepheards, as Psal.77.21."},{"verse":12,"text":"Exod. 14. 27. iosh. 15.16."},{"verse":15,"text":"Deut. 26. 15. , Or, the multitude."},{"verse":16,"text":"Or, our redeemer, from euerlasting is thy name."},{"verse":19,"text":"Heb. thy name was not called vpon them."}]