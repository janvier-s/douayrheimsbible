[{"verse":1,"text":"2.Kings.3.27."},{"verse":6,"text":"Chap.8.8."},{"verse":7,"text":"Or, young woman."},{"verse":8,"text":"Or, such as haue fined or mulcted."},{"verse":9,"text":"Num.21. 24. deut. 2. 31. iosh. 24.8."},{"verse":10,"text":"Exod. 12. 51."},{"verse":12,"text":"Cha.7.12."},{"verse":13,"text":"Or, I will presse your place as a cart full of sheaues presseth."},{"verse":14,"text":"Heb. his soule or life."},{"verse":16,"text":"Heb. strong of his heart."}]