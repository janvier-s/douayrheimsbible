[{"verse":2,"text":"Leuit.13. 3. , Leuit.15. 2. , Leuit.21, 1."},{"verse":6,"text":"Leuit.6. 3."},{"verse":7,"text":"Leui.6.5."},{"verse":9,"text":"Or, heaue offering."},{"verse":10,"text":"Leuit. 10. 12."},{"verse":19,"text":"Or, being in the power of thy husband. Hebr. vnder thy husband."},{"verse":21,"text":"Hebr. fall."}]