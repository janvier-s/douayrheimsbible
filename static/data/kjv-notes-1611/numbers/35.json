[{"verse":2,"text":"Iosh.21. 2."},{"verse":6,"text":"Deut.4. 41. iosh.20. 2. and 21.3. , Hebr. aboue them ye shall giue."},{"verse":8,"text":"Hebr. they inherite."},{"verse":10,"text":"Deut.19. 2. iosh.20. 2."},{"verse":11,"text":"Hebr. by error."},{"verse":16,"text":"Exod.21. 14."},{"verse":17,"text":"Hebr. with a stone of the hand."},{"verse":20,"text":"Deut. 19. 11."},{"verse":22,"text":"Exod. 21. 13."},{"verse":27,"text":"Hebr. no blood shalbe to him."},{"verse":30,"text":"Deut.17. 6.and 19. 15. matt.18 16. 2.cor. 13.1. Heb.10.28."},{"verse":31,"text":"Heb. faulty to die."},{"verse":33,"text":"Heb. there can be no expiation for the land."}]