[{"verse":3,"text":"Or, sea calues."},{"verse":6,"text":"Or, iniquitie. , Gen.19.25."},{"verse":8,"text":"Heb. darker then blacknesse."},{"verse":9,"text":"Heb. flow out."},{"verse":10,"text":"2.Kings 6.29. deut. 28.57."},{"verse":13,"text":"Ier.5.31. and 23. 21."},{"verse":14,"text":"Or, in that they could not but touch."},{"verse":15,"text":"Or, yee polluted."},{"verse":16,"text":"Or, face."},{"verse":20,"text":"Gen.2.7."},{"verse":22,"text":"Or, thine iniquitie. , Or, carie thee captiue for thy sinnes"}]