[{"verse":4,"text":"Heb. commeth for price."},{"verse":5,"text":"Heb. on our necks are we persecuted."},{"verse":7,"text":"Ier.31.29 ezek.18.2."},{"verse":10,"text":"Psal.11.38 , Or, terrors or stormes."},{"verse":16,"text":"Hebr. the crowne of our head is fallen."},{"verse":19,"text":"Psal.9.8. and 29.10. and 102.13. & 145.13."},{"verse":20,"text":"Heb. for length of dayes."},{"verse":21,"text":"Ier.31.18"},{"verse":22,"text":"Or, for wilt thou vtterly reiect vs?"}]