[{"verse":2,"text":"Hebr. as yesterday and the day before."},{"verse":10,"text":"Or, hee goates."},{"verse":13,"text":"Chap. 28. 18."},{"verse":19,"text":"Hebr. Teraphim."},{"verse":20,"text":"Hebr. the heart of Laban."},{"verse":24,"text":"Hebr. from good to bad."},{"verse":27,"text":"Hebr. hast stollen me."},{"verse":34,"text":"Hebr. felt."},{"verse":37,"text":"Hebr. felt."},{"verse":39,"text":"Exod.22. 12."},{"verse":47,"text":"That is, The heape of witnesse."},{"verse":49,"text":"That is, A beacon: or, watch tower."},{"verse":54,"text":"Or, killed beasts."}]