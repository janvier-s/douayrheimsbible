[{"verse":2,"text":"Exod. 20. 11. and 31. 17. deut. 5. 14. Hebr.4. 4."},{"verse":3,"text":"Heb. created to make."},{"verse":6,"text":"Or, a mist which went vp from &c."},{"verse":7,"text":"Heb. dust of the ground. , 1.Cor.15 47. , 1.Corin. 15.45."},{"verse":11,"text":"Ecclus. 24. 29."},{"verse":13,"text":"Heb. Cush."},{"verse":14,"text":"Or, Eastward to Assyria."},{"verse":15,"text":"Or, Adam."},{"verse":16,"text":"Hebr. eating thou shalt eate."},{"verse":17,"text":"Hebr. dying thou shalt die."},{"verse":18,"text":"Ecclus. 17.5. , Hebr. as before him."},{"verse":19,"text":"Or, the man."},{"verse":20,"text":"Hebr. called."},{"verse":22,"text":"Hebr. builded."},{"verse":23,"text":"1.Corin. 11.8."},{"verse":24,"text":"Matt. 19 5. mar.10. 7. 1.corin. 6.16. ephe. 5.31."}]