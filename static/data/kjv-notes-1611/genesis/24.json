[{"verse":1,"text":"Hebr. gone into dayes."},{"verse":2,"text":"Chap. 47. 29."},{"verse":7,"text":"Chap. 12. 7. and 13. 15. and 15. 18. and 26. 4."},{"verse":10,"text":"Or, And"},{"verse":11,"text":"Hebr. that wom which draw water, goe foorth."},{"verse":13,"text":"Vers.43."},{"verse":16,"text":"Hebr. good of countenance."},{"verse":22,"text":"Or, iewell for the forehead."},{"verse":43,"text":"Verse 13."},{"verse":53,"text":"Hebr. vessels."},{"verse":54,"text":"Vers. 56. and 59."},{"verse":55,"text":"Or, a full yeere, or, ten moneths."},{"verse":62,"text":"Chap. 16. 14. and 25. 11."},{"verse":63,"text":"Or, to pray."}]