[{"verse":1,"text":"Hebr. the sonne of one yeere in his reigning."},{"verse":3,"text":"Or, the hill."},{"verse":4,"text":"Hebr. did stinke."},{"verse":7,"text":"Hebr. trembled after him."},{"verse":8,"text":"Chap. 10. 8."},{"verse":10,"text":"Heb. blesse him."},{"verse":12,"text":"Hebr. intreated the face."},{"verse":15,"text":"Heb. found"},{"verse":21,"text":"Hebr. a file with mouthes. , Heb. to set."},{"verse":23,"text":"Or, standing campe."}]