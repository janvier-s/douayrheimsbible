[{"verse":1,"text":"Chap. 28. 3. ecclus. 46.13, 20."},{"verse":2,"text":"Or, busines."},{"verse":5,"text":"Heb. aske him in my name, of peace."},{"verse":7,"text":"Heb. shamed."},{"verse":9,"text":"Heb. rested."},{"verse":11,"text":"Hebr. slaughter."},{"verse":14,"text":"Hebr. flew vpon them."},{"verse":15,"text":"Heb. shamed."},{"verse":18,"text":"Or, lumps."},{"verse":24,"text":"Heb. eares"},{"verse":25,"text":"Heb. lay it to his heart."},{"verse":26,"text":"Hebr. sauing thy selfe."},{"verse":27,"text":"Or, present , Heb. walke at the feet of &c."},{"verse":29,"text":"Heb. in the midst of the bought of a sling."},{"verse":31,"text":"Hebr. no staggering: or, stumbling."},{"verse":42,"text":"Hebr. at her feet."},{"verse":43,"text":"Iosh.15. 56."},{"verse":44,"text":"2.Sam. 3. 14,15."}]