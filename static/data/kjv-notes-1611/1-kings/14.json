[{"verse":1,"text":"Or, there was a day."},{"verse":3,"text":"Chap. 4. 21."},{"verse":5,"text":"Heb. tooth."},{"verse":6,"text":"2. Chron. 14.11."},{"verse":9,"text":"Heb. be still."},{"verse":10,"text":"1. Macc. 4.30."},{"verse":14,"text":"Or, halfe a furrow of an acre of land."},{"verse":15,"text":"Hebr. a trembling of God."},{"verse":19,"text":"Or, tumult."},{"verse":20,"text":"Heb. were cryed together. , Iudg.7.22. 2.chro. 20.23."},{"verse":28,"text":"Or, wearie."},{"verse":32,"text":"Leuit.7. 26. and 19. 26. deut. 12.16."},{"verse":33,"text":"Or, dealt treacherously."},{"verse":34,"text":"Heb. in his hand."},{"verse":35,"text":"Hebr. that Altar he beganne to build vnto the LORD."},{"verse":38,"text":"Iudg.20.2 , Heb. corners."},{"verse":41,"text":"Or, shew the innocent , Heb. went forth."},{"verse":48,"text":"Or, wroght mightily."}]