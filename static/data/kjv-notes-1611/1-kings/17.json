[{"verse":1,"text":"Or, the coast of Dammim."},{"verse":2,"text":"Heb. ranged the battell."},{"verse":5,"text":"Heb. cloathed."},{"verse":6,"text":"Or, gorget."},{"verse":12,"text":"Chap. 16.1."},{"verse":18,"text":"Heb. cheeses of milke. , Heb. captaine of a thousand."},{"verse":20,"text":"Or, place of the cariage. , Or, battell ray, or place of fight."},{"verse":22,"text":"Hebr. the vessels from vpon him. , Heb. asked his brethren of peace."},{"verse":24,"text":"Heb. from his face."},{"verse":25,"text":"Iosh.15. 16."},{"verse":30,"text":"Hebr. word."},{"verse":31,"text":"Heb. tooke him."},{"verse":34,"text":"Or, kid."},{"verse":38,"text":"Heb. cloathed, &c. with his cloathes."},{"verse":40,"text":"Or, valley. , Heb. vessell."},{"verse":46,"text":"Hebr. sent thee vp."},{"verse":50,"text":"Ecclus. 47.4. 1. macc.4.30."}]