[{"verse":3,"text":"Hebr. hard."},{"verse":6,"text":"Deut. 32. 39. wisd. 16.13. tob. 13.2."},{"verse":8,"text":"Psal.113. 7."},{"verse":10,"text":"Chap.7. 10."},{"verse":16,"text":"Hebr. as on the day."},{"verse":18,"text":"Exod. 28. 4."},{"verse":20,"text":"Or, petition which hee asked, &c."},{"verse":22,"text":"Hebr. assembled by troupes."},{"verse":23,"text":"Or, I hear euill words of you."},{"verse":24,"text":"Or, to cry out."},{"verse":28,"text":"Leuit.10. 14."},{"verse":32,"text":"Or, the affliction of the Tabernacle, for all the wealth which God would haue giuen Israel."},{"verse":33,"text":"Heb. men."},{"verse":36,"text":"Heb. ioyne. , Or, Somewhat about the Priesthood."}]