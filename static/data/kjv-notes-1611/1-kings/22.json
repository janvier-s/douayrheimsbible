[{"verse":2,"text":"Hebr. had a creditour. , Hebr. bitter of soule."},{"verse":6,"text":"Or, groue in a hie place."},{"verse":8,"text":"Hebr. vncouereth mine eare."},{"verse":12,"text":"Hebr. behold me."},{"verse":15,"text":"Hebr. litle or great."},{"verse":17,"text":"Or, guard. Heb. the runners."}]