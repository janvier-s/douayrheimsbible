[{"verse":2,"text":"Or, vessell."},{"verse":5,"text":"Gr, hee stayed his course."},{"verse":6,"text":"Gen.1.16."},{"verse":7,"text":"Exo. 12.2."},{"verse":11,"text":"Gen.9.13."},{"verse":12,"text":"Esa.40.12."},{"verse":17,"text":"Or, to grone as a woman in her trauaile."},{"verse":19,"text":"Or, it is as the point of sharp stakes."},{"verse":22,"text":"Or, vpon the heat."},{"verse":25,"text":"Psal.107. 23."},{"verse":29,"text":"Psal.96.42"},{"verse":31,"text":"Psal.106.2 ioh.1.18."}]