[{"verse":1,"text":"Leuit. 9.2"},{"verse":7,"text":"Chap. 30. 25."},{"verse":9,"text":"Heb. bind. , Heb. fill the hand of. , Chap. 28. 41."},{"verse":10,"text":"Leuit. 1.4"},{"verse":13,"text":"Leuit. 3.3 , It seemeth by Anatomy, and the Hebrewe Doctours, to be the midriffe."},{"verse":17,"text":"Or, vpon."},{"verse":24,"text":"Or, shake to and fro."},{"verse":30,"text":"Hebr. He of his sonnes."},{"verse":32,"text":"Leuit. 8.31. matth. 12.4."},{"verse":38,"text":"Num. 28.3."},{"verse":43,"text":"Or, Israel."},{"verse":45,"text":"Leuit. 26.12. 2. cor. 6.16."}]