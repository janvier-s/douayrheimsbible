[{"verse":1,"text":"Or, receiue"},{"verse":2,"text":"Heb. answere."},{"verse":5,"text":"Deu. 22.4 , Or, wilt thou cease to helpe him? or, & wouldest cease to leaue thy businesse for him: thou shalt surely leaue it to ioyne with him."},{"verse":8,"text":"Deut. 16. 19. ecclus. 20.28. , Hebr. the seeing."},{"verse":9,"text":"Heb. soule."},{"verse":10,"text":"Leuit. 25. 3."},{"verse":11,"text":"Or, oliue trees."},{"verse":12,"text":"Chap. 20. 8. deut. 5. 13. luke 13. 14."},{"verse":14,"text":"Deut. 16. 16."},{"verse":15,"text":"Chap. 13.3 & 34.18. , Deut. 16. 16 ecclus. 35. 4."},{"verse":18,"text":"Or, feast."},{"verse":19,"text":"Chap. 34. 26. deut. 14 22."},{"verse":20,"text":"Chap. 33. 2."},{"verse":22,"text":"Or, I will afflict them that afflict thee."},{"verse":23,"text":"Chap. 33.2. , Iosh.24. 11."},{"verse":24,"text":"Deut. 7. 25."},{"verse":26,"text":"Deut. 7. 14."},{"verse":27,"text":"Heb. necks"},{"verse":28,"text":"Iosh. 24. 12."},{"verse":32,"text":"Chap. 34. 15. deut. 7. 2."},{"verse":33,"text":"Deut. 7. 16. iosh.23. 13. iudg.2 3."}]