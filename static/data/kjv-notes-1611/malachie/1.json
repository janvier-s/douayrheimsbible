[{"verse":1,"text":"Heb. by the hand of Malachi."},{"verse":2,"text":"Rom.9.13."},{"verse":5,"text":"Or, vpon. Heb. from vpon."},{"verse":7,"text":"Or, bring vnto &c."},{"verse":8,"text":"Heb. to sacrifice."},{"verse":9,"text":"Heb. the face of God. , Heb. from your hand."},{"verse":10,"text":"Isai.1.11. ier.6.20. amos.5.21."},{"verse":13,"text":"Or, whereas you might haue blowen it away."},{"verse":14,"text":"Heb. in whose flocke is."}]